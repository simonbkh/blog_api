APP_ENV=development
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s

DB_DSN=host=localhost user=blog password=blog dbname=blog_db port=5433 sslmode=disable
JWT_SECRET=replace-with-a-very-long-random-secret-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
RATE_LIMIT_IP_PER_MINUTE=120
RATE_LIMIT_USER_PER_MINUTE=300

SEED_SUPERADMIN_EMAIL=admin@example.com
SEED_SUPERADMIN_PASSWORD=ChangeMe123!
SEED_SUPERADMIN_FULL_NAME=Super Admin
